    <changeSet id="rollback-photos-jalon1" author="foodrush">

        <!-- Restauration photos restaurants Jalon I -->
        <update tableName="restaurants">
            <column name="photo" value="images/restaurant1.jpg"/>
            <where>nom = 'Chez Carlos' AND adresse = '123 Rue Principale, Trois-Rivières'</where>
        </update>
        <update tableName="restaurants">
            <column name="photo" value="images/restaurant2.jpg"/>
            <where>nom = 'La Table de Sophie'</where>
        </update>
        <update tableName="restaurants">
            <column name="photo" value="images/restaurant1.jpg"/>
            <where>nom = 'Chez Carlos' AND adresse = '456 Avenue des Pins, Trois-Rivières'</where>
        </update>

        <!-- Restauration photos plats Chez Carlos (123 Rue Principale) -->
        <update tableName="plats">
            <column name="photo" value="images/plat1.jpg"/>
            <where>nom = 'Tacos au boeuf' AND restaurant_id = (SELECT id FROM restaurants WHERE adresse = '123 Rue Principale, Trois-Rivières')</where>
        </update>
